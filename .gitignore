.DS_Store
.env
.venv/
__pycache__/
*.pyc
node_modules/
*.log

# Local-only configuration (Claude Code session settings, MCP launch config,
# and any worktree state). Nothing in here is needed by anyone cloning the
# repo, and settings.local.json captures local Bash command history that
# can include URLs with anon keys.
.claude/

# Supabase project URL + anon key — committed for Vercel deploys.
# The anon key is designed to be public (RLS gates everything server-side).
# If you fork into a different Supabase project, edit project/supabase-config.js
# with your own URL + anon key, or use Vercel env vars + a build step.
# (uncomment the line below to keep your config private)
# project/supabase-config.js
